#!/usr/bin/env python3
import json
import os
import pathlib
import urllib.request
import urllib.error
from flask import Flask, request, jsonify, Response, send_from_directory

DATA_FILE = pathlib.Path("/data/patterns.json")
SHARE_DIR = pathlib.Path("/share/tone-tools")

app = Flask(__name__)

def ensure_dirs():
    DATA_FILE.parent.mkdir(parents=True, exist_ok=True)
    SHARE_DIR.mkdir(parents=True, exist_ok=True)

@app.route("/health", methods=["GET"])
def health():
    return jsonify(status="ok")

@app.route("/patterns", methods=["GET"])
def get_patterns():
    ensure_dirs()
    if not DATA_FILE.exists():
        return jsonify(chimes=[], version=1)
    try:
        return Response(DATA_FILE.read_text(), mimetype="application/json")
    except Exception as e:
        return jsonify(error=str(e)), 500

@app.route("/patterns", methods=["PUT", "POST"])
def put_patterns():
    ensure_dirs()
    try:
        data = request.get_json(force=True)
        if data is None:
            return jsonify(error="invalid json"), 400
        text = json.dumps(data, indent=2)
        DATA_FILE.write_text(text)
        try:
            (SHARE_DIR / "patterns.json").write_text(text)
        except Exception:
            pass
        return jsonify(ok=True)
    except Exception as e:
        return jsonify(error=str(e)), 500

@app.route("/yaml", methods=["POST"])
def post_yaml():
    ensure_dirs()
    try:
        body = request.get_data(as_text=True)
        if not body:
            return jsonify(error="empty body"), 400
        out = SHARE_DIR / "chime.yaml"
        out.write_text(body)
        try:
            cfg = pathlib.Path("/config/esphome/tone-tools.yaml")
            if cfg.parent.exists():
                cfg.write_text(body)
        except Exception:
            pass
        return jsonify(ok=True, path=str(out))
    except Exception as e:
        return jsonify(error=str(e)), 500

@app.route("/mic_stream", methods=["GET"])
def mic_stream_proxy():
    host = request.args.get("host", "")
    path = request.args.get("path", "/mic_stream")
    if not host:
        return jsonify(error="missing ?host=<esphome-host>"), 400
    if not path.startswith("/"):
        path = "/" + path
    url = f"http://{host}{path}"
    try:
        req = urllib.request.Request(url, method="GET")
        with urllib.request.urlopen(req, timeout=15) as resp:
            headers = {"Content-Type": resp.headers.get_content_type() or "audio/L16"}
            def generate():
                while True:
                    chunk = resp.read(4096)
                    if not chunk:
                        break
                    yield chunk
            return Response(generate(), headers=headers)
    except urllib.error.HTTPError as e:
        return jsonify(error=f"upstream {e.code} {e.reason}", url=url), e.code
    except Exception as e:
        return jsonify(error=str(e), url=url), 502

@app.route("/share/<path:filename>", methods=["GET"])
def share_file(filename):
    ensure_dirs()
    return send_from_directory(SHARE_DIR, filename)

if __name__ == "__main__":
    ensure_dirs()
    app.run(host="127.0.0.1", port=8098, threaded=True)
